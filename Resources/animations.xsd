<?xml version="1.0" encoding="utf-8"?>
<xsd:schema
    elementFormDefault="qualified"
    attributeFormDefault="unqualified"
    targetNamespace="https://esheep.petrucci.ch/"
    xmlns="https://esheep.petrucci.ch/"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    version="2026.11.06">

  <xsd:annotation>
    <xsd:documentation>
      Schema of the animation file (animations.xml) of a desktop pet.
      The file is read by the application (XmlData.RootNode, Xml.cs) and by the Pet Editor (XmlTools.cs).
      Structure: header, image, spawns, animations, childs and (optional) sounds.
      Use this editor to edit the XML over a GUI: https://adrianotiger.github.io/desktopPet-Editor/
    </xsd:documentation>
  </xsd:annotation>

  <xsd:element name='animations'>
    <xsd:annotation>
      <xsd:documentation>Root node of the animation file. It contains the pet information, the sprite sheet, the spawns, the animations, the childs and the sounds.</xsd:documentation>
    </xsd:annotation>
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name='header' minOccurs='1' maxOccurs='1'>
          <xsd:annotation>
            <xsd:documentation>Main informations about this Pet.</xsd:documentation>
          </xsd:annotation>
          <xsd:complexType>
            <xsd:all>
              <xsd:element name='author' type='xsd:string' minOccurs='1' maxOccurs='1'>
                <xsd:annotation>
                  <xsd:documentation>Author of the animation, insert your name or full name.</xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element name='title' type='xsd:string' minOccurs='1' maxOccurs='1'>
                <xsd:annotation>
                  <xsd:documentation>Title of the animation, used on the webpage.</xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element name='petname' type='xsd:string' minOccurs='1' maxOccurs='1'>
                <xsd:annotation>
                  <xsd:documentation>Name of your pet. Displayed on the contextmenu (the word "eSheep" is replaced with this name). Max 16 characters, longer names are cut by the application.</xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element name='version' type='xsd:string' minOccurs='1' maxOccurs='1'>
                <xsd:annotation>
                  <xsd:documentation>Insert the application version, 0.1 for a beta.</xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element name='info' type='xsd:string' minOccurs='1' maxOccurs='1'>
                <xsd:annotation>
                  <xsd:documentation>
                      Info about the animation, write some sentences, credits and your email if you want. 
                      Use [br] to insert a line break and [link:URL] to add a clickable link (shown in the about box).
                      Other tags are not parsed.
                  </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element name='application' type='xsd:integer' minOccurs='1' maxOccurs='1'>
                <xsd:annotation>
                  <xsd:documentation>Application version, this must be set to 1, because this is the current and only version.</xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element name='icon' type='xsd:string' minOccurs='1' maxOccurs='1'>
                <xsd:annotation>
                  <xsd:documentation>
                      Icon as CDATA base64 encoded (ICO format, shown in the taskbar and tray), 
                      see https://adrianotiger.github.io/desktopPet-Editor/ to convert a PNG to ICO or get a base64 string.
                      The icon has to be a 48x48 pixel icon.
                  </xsd:documentation>
                </xsd:annotation>
              </xsd:element>
            </xsd:all>
          </xsd:complexType>
        </xsd:element>

        <xsd:element name='image'>
          <xsd:annotation>
            <xsd:documentation>All informations about the sprite image sheet.</xsd:documentation>
          </xsd:annotation>
          <xsd:complexType>
            <xsd:all>
              <xsd:element name='tilesx' type='xsd:integer' minOccurs='1' maxOccurs='1'>
                <xsd:annotation>
                  <xsd:documentation>How much images are on the x axis (tiles) of the sprite sheet.</xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element name='tilesy' type='xsd:integer' minOccurs='1' maxOccurs='1'>
                <xsd:annotation>
                  <xsd:documentation>How much images are on the y axis (tiles) of the sprite sheet.</xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element name='skins' type='xsd:integer' minOccurs='0' maxOccurs='1' default='0'>
                <xsd:annotation>
                  <xsd:documentation>How many different skins are present in the sprite sheet (optional). If not set, or value is 0, only 1 skin is used.</xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element name='png' type='xsd:string' minOccurs='1' maxOccurs='1'>
                <xsd:annotation>
                  <xsd:documentation>Sprite sheet as CDATA base64 encoded, see https://adrianotiger.github.io/desktopPet-Editor/ to convert it to a base64 string.</xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element name='transparency' type='xsd:string' minOccurs='1' maxOccurs='1'>
                <xsd:annotation>
                  <xsd:documentation>Transparency: color key used to show transparency. Default: Magenta</xsd:documentation>
                </xsd:annotation>
              </xsd:element>
            </xsd:all>
          </xsd:complexType>
        </xsd:element>

        <xsd:element name='spawns'>
          <xsd:annotation>
            <xsd:documentation>List of spawns. A spawn defines where and how the pet appears on the screen. If more spawns are defined, one is chosen randomly, based on its probability.</xsd:documentation>
          </xsd:annotation>
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name='spawn' maxOccurs='unbounded'>
                <xsd:annotation>
                  <xsd:documentation>A single spawn: start position of the pet and the first animation to play.</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:all>
                    <xsd:element name='x' type='expressionType' minOccurs='1' maxOccurs='1'>
                      <xsd:annotation>
                        <xsd:documentation>X start position of the pet, in pixels. Can be an expression (see expressionType), for example: random/100*screenW</xsd:documentation>
                      </xsd:annotation>
                    </xsd:element>
                    <xsd:element name='y' type='expressionType' minOccurs='1' maxOccurs='1'>
                      <xsd:annotation>
                        <xsd:documentation>Y start position of the pet, in pixels. Can be an expression (see expressionType), for example: areaH-imageH</xsd:documentation>
                      </xsd:annotation>
                    </xsd:element>
                    <xsd:element name='next' maxOccurs='1'>
                      <xsd:annotation>
                        <xsd:documentation>ID of the first animation to play after the pet was spawned.</xsd:documentation>
                      </xsd:annotation>
                      <!--
                      This node was present up to version 1.7, but it is wrong and it was not possible to set a probability, as the spawn-animation is onyl 1!
                      <xsd:complexType>
                        <xsd:simpleContent>
                          <xsd:extension base='xsd:integer'>
                            <xsd:attribute name="probability" type="probabilityType">
                              <xsd:annotation>
                                <xsd:documentation>Not used for spawns (the probability is defined on the spawn node).</xsd:documentation>
                              </xsd:annotation>
                            </xsd:attribute>
                          </xsd:extension>
                        </xsd:simpleContent>
                      </xsd:complexType>
                      -->
                    </xsd:element>
                  </xsd:all>
                  <xsd:attribute name="probability" type="probabilityType">
                    <xsd:annotation>
                      <xsd:documentation>Relative probability to use this spawn. If there are 3 spawns with probability 5, 12 and 3, the chances are: 25%, 60% and 15%.</xsd:documentation>
                    </xsd:annotation>
                  </xsd:attribute>
                  <xsd:attribute name="id" type="xsd:int">
                    <xsd:annotation>
                      <xsd:documentation>Unique ID of the spawn.</xsd:documentation>
                    </xsd:annotation>
                  </xsd:attribute>
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>

        <xsd:element name='animations'>
          <xsd:annotation>
            <xsd:documentation>List of all animations of the pet.</xsd:documentation>
          </xsd:annotation>
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name='animation' minOccurs='1' maxOccurs='unbounded'>
                <xsd:annotation>
                  <xsd:documentation>A single animation: how the pet moves, which frames are shown and which animation is played next.</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:all>
                    <xsd:element name='name' type='xsd:string' minOccurs='1' maxOccurs='1'>
                      <xsd:annotation>
                        <xsd:documentation>
                          Name of the animation, used for debugging. Some names have a special meaning for the application:
                          "drag" (animation while the pet is dragged),
                          "fall" (animation while the pet falls after it was released),
                          "toss" (animation while the pet is tossed, optional),
                          "fall soft" and "fall hard" (animation after a toss ends with a low or high speed),
                          "sync" (animation played when the pets are synchronized),
                          "kill" (animation played when the pet is closed).
                        </xsd:documentation>
                      </xsd:annotation>
                    </xsd:element>
                    <xsd:element name='start' minOccurs='1' maxOccurs='1'>
                      <xsd:annotation>
                        <xsd:documentation>Movement values at the beginning of the animation. Values of the frames in between are interpolated between start and end.</xsd:documentation>
                      </xsd:annotation>
                      <xsd:complexType>
                        <xsd:group ref="step"/>
                      </xsd:complexType>
                    </xsd:element>
                    <xsd:element name='end' minOccurs='1' maxOccurs='1'>
                      <xsd:annotation>
                        <xsd:documentation>Movement values at the end of the animation. Values of the frames in between are interpolated between start and end.</xsd:documentation>
                      </xsd:annotation>
                      <xsd:complexType>
                        <xsd:group ref="step"/>
                      </xsd:complexType>
                    </xsd:element>
                    <xsd:element name='sequence' minOccurs='1' maxOccurs='1'>
                      <xsd:annotation>
                        <xsd:documentation>Frames to show, how to repeat them and what to do once the sequence is over.</xsd:documentation>
                      </xsd:annotation>
                      <xsd:complexType>
                        <xsd:choice maxOccurs="unbounded">
                          <xsd:element name='frame' type='xsd:integer' minOccurs='1' maxOccurs='unbounded'>
                            <xsd:annotation>
                              <xsd:documentation>Index of the image (tile) of the sprite sheet to show. The first image has index 0, tiles are counted row by row.</xsd:documentation>
                            </xsd:annotation>
                          </xsd:element>
                          <xsd:element name='action' type='actionType' minOccurs='0' default='none'>
                            <xsd:annotation>
                              <xsd:documentation>Action to execute once the sequence is over: "flip" mirrors the pet (and its walking direction), "none" does nothing.</xsd:documentation>
                            </xsd:annotation>
                          </xsd:element>
                          <xsd:element ref='next' />
                        </xsd:choice>
                        <xsd:attribute name="repeat" type="expressionType">
                          <xsd:annotation>
                            <xsd:documentation>How many times the sequence should be executed (value of 0 or 1 is NO-REPEAT). Can be an expression (see expressionType), for example: 5+random/10</xsd:documentation>
                          </xsd:annotation>
                        </xsd:attribute>
                        <xsd:attribute name="repeatfrom" type="xsd:integer" default="0">
                          <xsd:annotation>
                            <xsd:documentation>If repeat is greater than 0, repeatfrom indicates from which frame the sequence is repeated.</xsd:documentation>
                          </xsd:annotation>
                        </xsd:attribute>
                      </xsd:complexType>
                    </xsd:element>
                    <xsd:element name='border' minOccurs='0' maxOccurs='1'>
                      <xsd:annotation>
                        <xsd:documentation>Next animations to play if the pet hits a border (screen, taskbar, window or another pet). If a border is hit and no matching next is defined, the pet ignores the border. Use the "only" attribute to select the kind of border.</xsd:documentation>
                      </xsd:annotation>
                      <xsd:complexType>
                        <xsd:sequence>
                          <xsd:element ref='next' maxOccurs='unbounded' />
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>
                    <xsd:element name='gravity' minOccurs='0' maxOccurs='1'>
                      <xsd:annotation>
                        <xsd:documentation>Next animations to play if the pet has no ground below anymore (for example the window under the pet was closed or moved). If missing, the pet is not affected by gravity.</xsd:documentation>
                      </xsd:annotation>
                      <xsd:complexType>
                        <xsd:sequence>
                          <xsd:element ref='next' maxOccurs='unbounded' />
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>
                  </xsd:all>
                  <xsd:attribute name="id" type="xsd:integer">
                    <xsd:annotation>
                      <xsd:documentation>Unique ID of the animation, used by the next nodes, spawns, childs and sounds to reference it.</xsd:documentation>
                    </xsd:annotation>
                  </xsd:attribute>
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>

        <xsd:element name='childs'>
          <xsd:annotation>
            <xsd:documentation>List of childs. A child is a second pet, created automatically each time the referenced animation starts. The child plays its own animations, starting with "next".</xsd:documentation>
          </xsd:annotation>
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name='child' minOccurs='0' maxOccurs='unbounded'>
                <xsd:annotation>
                  <xsd:documentation>A single child.</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:all>
                    <xsd:element name='x' type='expressionType' minOccurs='1' maxOccurs='1'>
                      <xsd:annotation>
                        <xsd:documentation>X position of the child when it is created, in pixels. Can be an expression (see expressionType). imageX is the X position of the parent. If the parent is flipped, imageW is mirrored.</xsd:documentation>
                      </xsd:annotation>
                    </xsd:element>
                    <xsd:element name='y' type='expressionType' minOccurs='1' maxOccurs='1'>
                      <xsd:annotation>
                        <xsd:documentation>Y position of the child when it is created, in pixels. Can be an expression (see expressionType). imageY is the Y position of the parent.</xsd:documentation>
                      </xsd:annotation>
                    </xsd:element>
                    <xsd:element name='next' maxOccurs='1'>
                      <xsd:annotation>
                        <xsd:documentation>ID of the first animation to play for the child.</xsd:documentation>
                      </xsd:annotation>
                      <xsd:complexType>
                        <xsd:simpleContent>
                          <xsd:extension base='xsd:integer'>
                            <xsd:attribute name="probability" type="probabilityType">
                              <xsd:annotation>
                                <xsd:documentation>Not used for childs.</xsd:documentation>
                              </xsd:annotation>
                            </xsd:attribute>
                          </xsd:extension>
                        </xsd:simpleContent>
                      </xsd:complexType>
                    </xsd:element>
                  </xsd:all>
                  <xsd:attribute name="animationid" type="xsd:int">
                    <xsd:annotation>
                      <xsd:documentation>ID of the animation which creates this child, once it is executed.</xsd:documentation>
                    </xsd:annotation>
                  </xsd:attribute>
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>

        <xsd:element name='sounds' minOccurs='0' maxOccurs='1'>
          <xsd:annotation>
            <xsd:documentation>List of sounds (optional). A sound is played when the referenced animation is executed.</xsd:documentation>
          </xsd:annotation>
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name='sound' minOccurs='0' maxOccurs='unbounded'>
                <xsd:annotation>
                  <xsd:documentation>A single sound.</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:all>
                    <xsd:element name='probability' minOccurs='1' maxOccurs='1'>
                      <xsd:annotation>
                        <xsd:documentation>Probability (in %, from 0 to 100) that this sound is played together with the animation.</xsd:documentation>
                      </xsd:annotation>
                      <xsd:simpleType>
                        <xsd:restriction base='xsd:integer'>
                          <xsd:minInclusive value='0' />
                          <xsd:maxInclusive value='100' />
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name='loop' type='xsd:integer' minOccurs='0' maxOccurs='1' default='0'>
                      <xsd:annotation>
                        <xsd:documentation>How many times the sound should loop (default: 0). 1 means that the sound will play 2 times.</xsd:documentation>
                      </xsd:annotation>
                    </xsd:element>
                    <xsd:element name='base64' type='xsd:string' minOccurs='1' maxOccurs='1'>
                      <xsd:annotation>
                        <xsd:documentation>The mp3 sound as base64 encoded string.</xsd:documentation>
                      </xsd:annotation>
                    </xsd:element>
                  </xsd:all>
                  <xsd:attribute name="animationid" type="xsd:int">
                    <xsd:annotation>
                      <xsd:documentation>ID of the animation which plays this sound, once it is executed.</xsd:documentation>
                    </xsd:annotation>
                  </xsd:attribute>
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>

      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>

  <xsd:simpleType name="expressionType">
    <xsd:annotation>
      <xsd:documentation>
        Integer expression, evaluated by the application (DataTable.Compute) each time the animation is started.
        It can contain numbers, the operators + - * / % ( ), comparisons (&lt; &gt; =), iif(condition, a, b), and, or, not,
        Convert(value, System.Int32) (for example to get an integer division)
        and the following keywords, which are replaced by the application before the evaluation:
        screenW: width of the screen.
        screenH: height of the screen.
        areaW: width of the working area (screen without taskbar).
        areaH: bottom of the working area (screen height without taskbar).
        imageW: width of a single sprite image (negated for children if the parent is flipped).
        imageH: height of a single sprite image.
        imageX: X position of the parent (only for childs, -1 if the pet is not a child).
        imageY: Y position of the parent (only for childs, -1 if the pet is not a child).
        random: random value between 0 and 99, a new one each time the expression is evaluated.
        randS: random value between 10 and 89, chosen once each time the animation file is loaded (same value for all expressions).
        scale: scale factor of the pet (used on HD monitors).
        Examples: "5+random/10", "screenW-imageW", "areaH-imageH", "-imageW".
        The result is truncated to an integer.
      </xsd:documentation>
    </xsd:annotation>
    <xsd:restriction base="xsd:string">
      <xsd:pattern value="(\s|[0-9]|\.|\+|\-|\*|/|%|\(|\)|,|&lt;|&gt;|=|screenW|screenH|areaW|areaH|imageW|imageH|imageX|imageY|randS|random|scale|[Ii][Ii][Ff]|[Aa][Nn][Dd]|[Oo][Rr]|[Nn][Oo][Tt]|[Tt][Rr][Uu][Ee]|[Ff][Aa][Ll][Ss][Ee]|[Cc][Oo][Nn][Vv][Ee][Rr][Tt]|System\.(Int16|Int32|Int64|Single|Double|Decimal|Byte))+" />
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:simpleType name="probabilityType">
    <xsd:annotation>
      <xsd:documentation>Relative probability (not a percentage). If there are 3 next nodes with probability 5, 12 and 3, the chances are: 25%, 60% and 15%. A probability of 0 means that the animation is never chosen randomly.</xsd:documentation>
    </xsd:annotation>
    <xsd:restriction base="xsd:integer">
      <xsd:minInclusive value="0" />
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:simpleType name="actionType">
    <xsd:annotation>
      <xsd:documentation>Action to execute at the end of a sequence.</xsd:documentation>
    </xsd:annotation>
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="none">
        <xsd:annotation>
          <xsd:documentation>Do nothing.</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="flip">
        <xsd:annotation>
          <xsd:documentation>Flip the pet: the sprites are mirrored and the pet walks in the opposite direction.</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:simpleType name="borderType">
    <xsd:annotation>
      <xsd:documentation>
        Limits a next animation to a kind of border/surface (attribute "only").
        If the value is "none", empty or not set, the next animation is always a candidate.
        Values with a "+" are groups: "horizontal+" also matches "taskbar", "window" and "horizontal"; "vertical+" also matches "vertical", "windowSide" and "petSide".
      </xsd:documentation>
    </xsd:annotation>
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="">
        <xsd:annotation>
          <xsd:documentation>Same as "none".</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="none">
        <xsd:annotation>
          <xsd:documentation>No restriction: this next animation is used on every border (default).</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="taskbar">
        <xsd:annotation>
          <xsd:documentation>Only if the pet is on the taskbar (bottom of the working area).</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="window">
        <xsd:annotation>
          <xsd:documentation>Only if the pet is on the top of a window.</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="windowSide">
        <xsd:annotation>
          <xsd:documentation>Only if the pet hits the left or right side of a window.</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="horizontal">
        <xsd:annotation>
          <xsd:documentation>Only if the pet hits the upper border of the screen.</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="horizontal+">
        <xsd:annotation>
          <xsd:documentation>Only if the pet hits a horizontal border: upper screen border, taskbar or top of a window.</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="vertical">
        <xsd:annotation>
          <xsd:documentation>Only if the pet hits the left or right border of the screen.</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="vertical+">
        <xsd:annotation>
          <xsd:documentation>Only if the pet hits any vertical border: left or right screen border, side of a window or side of another pet.</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="petSide">
        <xsd:annotation>
          <xsd:documentation>Only if the pet hits the left or right side of another pet. Tip: add petSide animations with probability 0 to let pets mimic each other.</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:group name="step">
    <xsd:annotation>
      <xsd:documentation>Movement values of an animation step (start or end). The frames between start and end are interpolated.</xsd:documentation>
    </xsd:annotation>
    <xsd:all>
      <xsd:element name='x' type='expressionType' minOccurs='1' maxOccurs='1'>
        <xsd:annotation>
          <xsd:documentation>How many pixels to move on the X axis for each frame (negative values move to the left). Can be an expression (see expressionType).</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name='y' type='expressionType' minOccurs='1' maxOccurs='1'>
        <xsd:annotation>
          <xsd:documentation>How many pixels to move on the Y axis for each frame (negative values move up). Can be an expression (see expressionType).</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name='offsety' type='xsd:integer' minOccurs='0' maxOccurs='1' default='0'>
        <xsd:annotation>
          <xsd:documentation>Graphical offset of the image on the Y axis, from the physical position calculated for the pet (default: 0).</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name='opacity' minOccurs='0' maxOccurs='1' default='1.0'>
        <xsd:annotation>
          <xsd:documentation>Opacity of the pet, from 0.0 (invisible) to 1.0 (opaque). Default: 1.0</xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
          <xsd:restriction base='xsd:double'>
            <xsd:minInclusive value='0.0' />
            <xsd:maxInclusive value='1.0' />
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:element>
      <xsd:element name='interval' type='expressionType' minOccurs='1' maxOccurs='1'>
        <xsd:annotation>
          <xsd:documentation>Interval in milliseconds until the next frame is shown. Can be an expression (see expressionType).</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:all>
  </xsd:group>

  <xsd:element name="next">
    <xsd:annotation>
      <xsd:documentation>ID of the next animation to play. Used in a sequence (when the sequence is over), in border (when a border is hit) and in gravity (when the pet falls). If more next nodes are available, one is chosen randomly using the probability, considering only the nodes which match the "only" attribute.</xsd:documentation>
    </xsd:annotation>
    <xsd:complexType>
      <xsd:simpleContent>
        <xsd:extension base='xsd:integer'>
          <xsd:attribute name="probability" type="probabilityType">
            <xsd:annotation>
              <xsd:documentation>Relative probability that this will be the next animation. If there are 3 next nodes with probability 5, 12 and 3, the chances are: 25%, 60% and 15%.</xsd:documentation>
            </xsd:annotation>
          </xsd:attribute>
          <xsd:attribute name="only" type="borderType">
            <xsd:annotation>
              <xsd:documentation>Execute this next animation only for the selected kind of border or surface (see borderType). Default: none.</xsd:documentation>
            </xsd:annotation>
          </xsd:attribute>
        </xsd:extension>
      </xsd:simpleContent>
    </xsd:complexType>
  </xsd:element>

  <xsd:element name="only">
    <xsd:annotation>
      <xsd:documentation>Container of next nodes. Not read by the application.</xsd:documentation>
    </xsd:annotation>
    <xsd:complexType>
      <xsd:choice minOccurs="0" maxOccurs="unbounded">
        <xsd:element ref="next" />
      </xsd:choice>
    </xsd:complexType>
  </xsd:element>
</xsd:schema>
